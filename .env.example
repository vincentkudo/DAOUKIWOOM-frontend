# ============================================================
# RoomFlow — copy to .env and fill real values before deploy
#   cp .env.example .env
# Never commit .env
# ============================================================

# --- Database ---
POSTGRES_DB=roomflow
POSTGRES_USER=roomflow
POSTGRES_PASSWORD=change-this-strong-db-password
POSTGRES_PORT=5432

# --- Backend ---
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8080
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_EXPIRATION_MINUTES=480
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Comma-separated origins that may call the API from a browser.
# Same-origin docker (nginx proxy) still needs the public site URL.
CORS_ORIGINS=https://your-domain.com,http://localhost

# Seed demo users/rooms only on empty database. Keep false in real prod
# after the first demo, or true if you want the reviewer demo accounts.
SEED_ENABLED=true
SEED_ADMIN_PASSWORD=Admin123!
SEED_EMPLOYEE_PASSWORD=Emp123!

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password
ROOM_HOLD_SECONDS=90

# --- Frontend ---
FRONTEND_PORT=80
# Leave empty when nginx proxies /api to the backend (recommended).
# Set to the public API URL only if FE and BE are hosted separately.
VITE_API_URL=
